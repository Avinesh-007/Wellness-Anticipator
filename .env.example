# Environment Configuration for Wellness Anticipator

# Application
PROJECT_NAME="Wellness Anticipator API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Cryptography
# Generate secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="insecure-dev-secret-key-change-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: SQLite for zero-dependency local dev; switch to PostgreSQL in prod)
DATABASE_URL="sqlite:///./wellness_anticipator.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/wellness_db"

# CORS Configuration (Comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Logging
LOG_LEVEL="INFO"
